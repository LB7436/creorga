# Variables injectées par Vite au build de production de la CAISSE.
#
# Sans ce fichier, `SeatPanel.tsx` et `lib/floorBridge.ts` retombaient sur
# `http://localhost:3002` : toute reconstruction hors du VPS (nouveau poste,
# CI, serveur réinstallé) produisait une caisse dont la synchronisation du
# plan de salle et le menu par siège appelaient une adresse locale — panne
# partielle et silencieuse, du même type que celle du tunnel Cloudflare mort
# côté apps/web.
#
# On vise creorga.n8nautomatisations.org (et non caisse.…) parce que
# floorBridge synchronise la caisse AVEC le back-office ; les deux domaines
# relaient de toute façon /api/* vers le même backend 127.0.0.1:3002.
# Aucun secret ici : ce sont des URL publiques.

VITE_BACKEND_URL=https://creorga.n8nautomatisations.org

# `lib/payments.ts` utilise un chemin relatif (/api) qui fonctionne derrière
# Caddy : c'est ce qui masquait la panne des deux autres points d'appel.
VITE_API_URL=/api
