model LeaveRequest {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  type      String   // VACATION|SICK|OTHER
  startDate DateTime
  endDate   DateTime
  status    String   @default("PENDING") // PENDING|APPROVED|REJECTED
