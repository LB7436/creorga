generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── SOCIETE ───────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  legalProfile Json?
  vatNumber String?
  address   String?
  phone     String?
  email     String?
  logo      String?
  currency  String   @default("EUR")
  timezone  String   @default("Europe/Luxembourg")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           UserCompany[]
  tables          Table[]
  categories      Category[]
  products        Product[]
  orders          Order[]
  settings        CompanySettings?
  modules         CompanyModule[]
  customers       Customer[]
  giftCards       GiftCard[]
  invoices        Invoice[]
  quotes          Quote[]
  reservations    Reservation[]
  ingredients     Ingredient[]
  suppliers       Supplier[]
  purchaseOrders  PurchaseOrder[]
  shifts          Shift[]
  timePunches     TimePunch[]
  leaveRequests   LeaveRequest[]
  haccpLogs       HaccpLog[]
  haccpTasks      HaccpTask[]
  campaigns       Campaign[]
  discountCodes   DiscountCode[]
  cashDrawers     CashDrawer[]
  expenses        Expense[]
  reviews         Review[]
  eventQuotes     EventQuote[]
  portalConfig    PortalConfiguration?
  posSales        PosSale[]
  posClosures     PosClosure[]
  paymentAttempts PaymentAttempt[]
  guestVisits     GuestVisit[]
  floorWorkspace  FloorWorkspace?
  serviceSessions ServiceSession[]
  tableMovements TableMovement[]
  payoutStatements PayoutStatement[]
}

// Autorité progressive des sessions ouvertes. Le fichier reste un miroir de compatibilité.
model FloorWorkspace {
  companyId String @id
  revision BigInt
  snapshot Json
  snapshotHash String
  initialSnapshot Json
  initialHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  changes FloorChange[]
}

model FloorChange {
  id String @id @default(uuid())
  companyId String
  revision BigInt
  actorId String
  action String
  beforeHash String
  afterHash String
  delta Json
  createdAt DateTime @default(now())
  workspace FloorWorkspace @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  @@unique([companyId, revision])
}

// Identité durable du service : déplacer un couvert ne recrée pas sa commande.
model ServiceSession {
  id String @id @default(uuid())
  companyId String
  tableId String
  openedAt DateTime @default(now())
  closedAt DateTime?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  covers ServiceCover[]
  @@unique([companyId, id])
  @@index([companyId, tableId, closedAt])
}

model ServiceCover {
  id String @id @default(uuid())
  companyId String
  coverId String
  sessionId String
  orderId String?
  items Json
  state String @default("OPEN")
  actorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  session ServiceSession @relation(fields: [companyId, sessionId], references: [companyId, id], onDelete: Cascade)
  order Order? @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Restrict)
  @@unique([companyId, coverId])
  @@index([companyId, orderId])
}

model CompanySettings {
  id             String  @id @default(cuid())
  companyId      String  @unique
  posMode        String  @default("restaurant")
  taxRate1       Float   @default(3)
  taxRate2       Float   @default(8)
  taxRate3       Float   @default(14)
  taxRate4       Float   @default(17)
  defaultTaxRate Float   @default(17)
  currency       String  @default("EUR")
  receiptFooter  String?
  printerIp      String?

  company Company @relation(fields: [companyId], references: [id])
}

model PortalConfiguration {
  id             String   @id @default(cuid())
  companyId      String   @unique
  toggles        Json     @default("{}")
  games          Json     @default("{}")
  welcomeMessage String   @default("")
  accentColor    String   @default("#6366f1")
  tableNumber    String   @default("1")
  themeMode      String   @default("dark")
  logoDataUrl    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ─── UTILISATEURS ──────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies     UserCompany[]
  orders        Order[]
  refreshTokens RefreshToken[]
  shifts        Shift[]
  timePunches   TimePunch[]
  leaveRequests LeaveRequest[]
  cashDrawers   CashDrawer[]
  expenses      Expense[]
}

model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("EMPLOYEE")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  profile EmployeeProfile?

  @@unique([userId, companyId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── PLAN DE SALLE ─────────────────────────────────────

model Table {
  id        String   @id @default(cuid())
  companyId String
  name      String
  section   String   @default("Salle")
  capacity  Int      @default(4)
  posX      Float    @default(0)
  posY      Float    @default(0)
  width     Float    @default(120)
  height    Float    @default(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id])
  orders       Order[]
  reservations Reservation[]
  @@unique([companyId, id])
}

// ─── CATALOGUE PRODUITS ────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  companyId String
  name      String
  icon      String?
  color     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id])
  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  categoryId  String
  name        String
  description String?
  price       Float
  taxRate     Float    @default(17)
  image       String?
  allergens   String[] @default([])
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  stock       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  recipes    Recipe[]
}

// ─── COMMANDES ─────────────────────────────────────────

model Order {
  id            String    @id @default(cuid())
  companyId     String
  tableId       String?
  userId        String?
  source        String    @default("BACKOFFICE")
  externalTableId String?
  publicToken   String?   @unique
  guestStatus   String?
  guestVisitId  String?
  guestRequestHash String?
  customerId    String?
  orderNumber   Int
  status        String    @default("OPEN")
  notes         String?
  subtotal      Float     @default(0)
  taxAmount     Float     @default(0)
  total         Float     @default(0)
  paidAt        DateTime?
  inventoryDebitedAt DateTime?
  paymentMethod String?
  cashReceived  Float?
  cashChange    Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company  Company    @relation(fields: [companyId], references: [id])
  table    Table?     @relation(fields: [tableId], references: [id])
  user     User?      @relation(fields: [userId], references: [id])
  customer Customer?  @relation("CustomerOrders", fields: [customerId], references: [id])
  items    OrderItem[]
  paymentAttempts PaymentAttempt[]
  paymentSettlements PaymentSettlement[]
  paymentAllocations PaymentAllocation[]
  tenders OrderTender[]
  refundAllocations RefundAllocation[]
  serviceCovers ServiceCover[]
  serviceAllocation ServiceAllocation?
  serviceShares ServiceShare[]
  guestVisit GuestVisit? @relation(fields: [companyId, guestVisitId], references: [companyId, id])

  // Deux commandes ne peuvent pas porter le même numéro dans une société :
  // la numérotation applicative (lecture du max + 1) ne suffit pas sous
  // charge, c'est la base qui doit trancher.
  @@unique([companyId, orderNumber])
  @@unique([companyId, id])
  // Tous les agrégats de la console créateur (CA du jour, extraits, snapshot
  // quotidien) filtrent par société puis paidAt/status : sans ces index,
  // chaque calcul balaie la table entière.
  @@index([companyId, paidAt])
  @@index([companyId, status])
}

// Une visite est une autorisation d'accès, jamais une preuve d'occupation/paiement.
model GuestVisit {
  id String @id @default(uuid())
  companyId String
  tableId String
  openedAt DateTime @default(now())
  expiresAt DateTime
  openedBy String
  closedAt DateTime?
  closedBy String?
  closeReason String?
  company Company @relation(fields: [companyId], references: [id])
  accesses GuestVisitAccess[]
  orders Order[]
  paymentAttempts PaymentAttempt[]
  serviceShares ServiceShare[]
  @@unique([companyId, id])
  @@index([companyId, tableId])
}

model GuestVisitAccess {
  id String @id @default(uuid())
  companyId String
  visitId String
  tokenHash String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  revokeReason String?
  visit GuestVisit @relation(fields: [companyId, visitId], references: [companyId, id])
  @@index([companyId, visitId])
}

// Déplacement de localisation, jamais duplication de vente ou de préparation.
model TableMovement {
  id String @id
  companyId String
  actorId String
  requestHash String
  snapshot Json
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId, createdAt])
}

// Une commande historique, plusieurs créances de service. Aucun clone de vente.
model ServiceAllocation {
  id String @id
  companyId String
  orderId String
  actorId String
  requestHash String
  planHash String
  snapshot Json
  createdAt DateTime @default(now())
  order Order @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Restrict)
  shares ServiceShare[]
  @@unique([companyId, orderId])
  @@unique([companyId, orderId, id])
}

model ServiceShare {
  id String @id
  companyId String
  orderId String
  allocationId String
  visitId String
  tableId String
  label String
  totalCents Int
  snapshot Json
  createdAt DateTime @default(now())
  allocation ServiceAllocation @relation(fields: [companyId, orderId, allocationId], references: [companyId, orderId, id], onDelete: Cascade)
  order Order @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Restrict)
  visit GuestVisit @relation(fields: [companyId, visitId], references: [companyId, id], onDelete: Restrict)
  tenders ServiceShareTender[]
  @@unique([companyId, orderId, id])
  @@unique([companyId, visitId])
  @@index([companyId, tableId])
}

model ServiceShareTender {
  id String @id @default(uuid())
  companyId String
  orderId String
  shareId String
  tenderId String
  amountCents Int
  createdAt DateTime @default(now())
  share ServiceShare @relation(fields: [companyId, orderId, shareId], references: [companyId, orderId, id], onDelete: Cascade)
  tender OrderTender @relation(fields: [companyId, orderId, tenderId], references: [companyId, orderId, id], onDelete: Restrict)
  @@unique([companyId, tenderId, shareId])
}

model OrderItem {
  id        String   @id @default(cuid())
  sourceLineId String?
  orderId   String
  productId String
  productName String?
  quantity  Int
  unitPrice Float
  taxRate   Float
  notes     String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// Tentative persistée AVANT l'appel bancaire. Une réponse perdue ne libère pas le solde.
model PaymentAttempt {
  id               String   @id @default(uuid())
  companyId        String
  orderId          String
  tableId          String?
  guestVisitId     String?
  scope            String   @default("ORDER")
  userId           String?
  requestId        String
  requestHash      String
  provider         String
  merchantId       String
  amountCents      Int
  currency         String
  status           String   @default("CREATING")
  externalId       String?
  createRequestId  String   @default(uuid())
  captureRequestId String   @default(uuid())
  response         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id])
  order   Order   @relation(fields: [companyId, orderId], references: [companyId, id])
  settlement PaymentSettlement?
  allocations PaymentAllocation[]
  tenders OrderTender[]
  guestVisit GuestVisit? @relation(fields: [companyId, guestVisitId], references: [companyId, id])
  @@unique([companyId, id])
  @@unique([companyId, requestId])
  @@unique([provider, merchantId, externalId])
  @@index([companyId, orderId, status])
}

model PaymentSettlement {
  id          String   @id @default(uuid())
  companyId   String
  orderId     String
  attemptId   String   @unique
  provider    String
  merchantId  String
  captureId   String
  amountCents Int
  currency    String
  feesCents   Int?
  netCents    Int?
  createdAt   DateTime @default(now())
  order       Order @relation(fields: [companyId, orderId], references: [companyId, id])
  attempt     PaymentAttempt @relation(fields: [companyId, attemptId], references: [companyId, id])
  allocations PaymentAllocation[]
  tenders OrderTender[]
  refunds RefundAttempt[]
  payoutLines PayoutLine[]
  @@unique([companyId, id])
  @@unique([companyId, attemptId])
  @@unique([provider, merchantId, captureId])
  @@index([companyId, orderId])
}

// Affectation et réservation de chaque commande, y compris les additions multi-tournées.
model PaymentAllocation {
  id           String @id @default(uuid())
  companyId    String
  attemptId    String
  orderId      String
  amountCents  Int
  active       Boolean @default(true)
  settlementId String?
  createdAt    DateTime @default(now())
  order        Order @relation(fields: [companyId, orderId], references: [companyId, id])
  attempt      PaymentAttempt @relation(fields: [companyId, attemptId], references: [companyId, id])
  settlement   PaymentSettlement? @relation(fields: [companyId, settlementId], references: [companyId, id])
  @@unique([attemptId, orderId])
  @@index([companyId, orderId, active])
}

model PaymentWebhook {
  id              String   @id
  companyId       String
  provider        String
  eventId         String
  eventType       String
  externalOrderId String?
  payloadHash     String
  status          String   @default("RECEIVED")
  receivedAt      DateTime @default(now())
  processedAt     DateTime?
  @@unique([companyId, provider, eventId])
  @@index([companyId, status])
}

// Journal serveur immuable : un même règlement ne peut être enregistré deux fois.
model PosSale {
  id        String   @id
  companyId String
  userId    String
  number    Int
  snapshot  Json
  closedId  String?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
  covers    PosCoverPayment[]
  invoice   Invoice?
  origins   SaleOrigin[]
  tenders   OrderTender[]
  @@unique([companyId, id])
  @@unique([companyId, number])
  @@index([companyId, closedId])
}

// Affectations de règlement append-only côté API : ne recréent aucune vente.
model OrderTender {
  id String @id @default(uuid())
  companyId String
  orderId String
  actorId String?
  attemptId String?
  saleId String?
  settlementId String?
  method String
  confirmation String
  amountCents Int
  tipCents Int @default(0)
  charityCents Int @default(0)
  cashReceivedCents Int?
  cashChangeCents Int?
  cashDrawerId String?
  createdAt DateTime @default(now())
  order Order @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Cascade)
  attempt PaymentAttempt? @relation(fields: [companyId, attemptId], references: [companyId, id], onDelete: Cascade)
  sale PosSale? @relation(fields: [companyId, saleId], references: [companyId, id], onDelete: Cascade)
  settlement PaymentSettlement? @relation(fields: [companyId, settlementId], references: [companyId, id], onDelete: Cascade)
  cashDrawer CashDrawer? @relation(fields: [companyId, cashDrawerId], references: [companyId, id], onDelete: Restrict)
  manualRefunds ManualRefund[]
  serviceShares ServiceShareTender[]
  @@unique([companyId, id])
  @@unique([companyId, orderId, id])
  @@unique([companyId, attemptId, orderId, method])
  @@unique([companyId, saleId, orderId, method])
  @@index([companyId, orderId])
  @@index([companyId, cashDrawerId])
}

// Une provenance ne peut alimenter qu'une vente, même si un ancien plan change son couvert.
model SaleOrigin {
  id String @id @default(uuid())
  companyId String
  kind String
  sourceId String
  saleId String
  createdAt DateTime @default(now())
  sale PosSale @relation(fields: [companyId, saleId], references: [companyId, id], onDelete: Cascade)
  @@unique([companyId, kind, sourceId])
  @@index([companyId, saleId])
}

model PosCoverPayment {
  id        String @id @default(cuid())
  companyId String
  coverId   String
  saleId    String
  sale      PosSale @relation(fields: [saleId], references: [id])
  @@unique([companyId, coverId])
}

model PosClosure {
  id        String   @id
  companyId String
  userId    String
  snapshot  Json
  createdAt DateTime @default(now())
  company   Company @relation(fields: [companyId], references: [id])
  @@index([companyId, createdAt])
}

model PosReceiptDelivery {
  id        String @id
  companyId String
  saleId    String
  recipient String
  status    String @default("PENDING")
  providerId String?
  createdAt DateTime @default(now())
  @@index([companyId, saleId])
}

// ─── MODULES ───────────────────────────────────────────

model CompanyModule {
  id        String    @id @default(cuid())
  companyId String
  moduleId  String
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
  @@index([companyId])
}

// ─── CRM ───────────────────────────────────────────────

model Customer {
  id            String   @id @default(cuid())
  companyId     String
  firstName     String
  lastName      String
  businessName  String?
  address       String?
  vatNumber     String?
  email         String?
  phone         String?
  points        Int      @default(0)
  walletBalance Float    @default(0)
  isGuest       Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  loyaltyTransactions LoyaltyTransaction[]
  reviews             Review[]
  invoices            Invoice[]
  quotes              Quote[]
  eventQuotes         EventQuote[]
  orders              Order[]              @relation("CustomerOrders")

  @@index([companyId])
  @@unique([companyId, id])
}

model LoyaltyTransaction {
  id         String   @id @default(cuid())
  customerId String
  type       String   // EARN | SPEND | TOPUP
  points     Int
  amount     Float    @default(0)
  orderId    String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model GiftCard {
  id             String    @id @default(cuid())
  companyId      String
  code           String    @unique
  initialValue   Float
  currentBalance Float
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─── FACTURATION ───────────────────────────────────────

model Invoice {
  id         String    @id @default(cuid())
  companyId  String
  customerId String?
  number     String
  status     String    @default("DRAFT") // DRAFT|SENT|PAID|OVERDUE|CANCELLED
  currency   String    @default("EUR")
  priceBasis String    @default("HT")
  discountCents Int    @default(0)
  serviceDate DateTime?
  documentMode String @default("AUTO")
  issuedAt   DateTime?
  issuedSnapshot Json?
  issuedPdf  Bytes?
  issuedPdfHash String?
  dueDate    DateTime?
  subtotal   Float     @default(0)
  taxAmount  Float     @default(0)
  total      Float     @default(0)
  pdfUrl     String?
  notes      String?
  orderId    String?
  sourcePosSaleId String? @unique
  sourceReceipt Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id])
  items    InvoiceItem[]
  deliveries InvoiceDelivery[]
  documentLinks InvoiceDocumentLink[]
  creditNotes CreditNote[]
  sourcePosSale PosSale? @relation(fields: [companyId, sourcePosSaleId], references: [companyId, id], onDelete: Restrict, map: "Invoice_sourcePosSale_fkey")
  sourceQuote Quote?

  // Numérotation séquentielle unique : obligation légale de facturation.
  @@unique([companyId, number])
  @@unique([companyId, id])
  @@unique([companyId, sourcePosSaleId])
  @@index([companyId, status])
}

// Pièce de correction immuable côté API. Un avoir n'est pas un remboursement.
model CreditNote {
  id String @id
  companyId String
  invoiceId String
  number String
  actorId String
  reason String
  requestHash String
  currency String
  totalCents Int
  baseCents Int
  taxCents Int
  taxGroups Json
  snapshot Json
  pdf Bytes
  pdfHash String
  createdAt DateTime @default(now())
  invoice Invoice @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: Restrict)
  refunds RefundAttempt[]
  manualRefunds ManualRefund[]
  @@unique([companyId, id])
  @@unique([companyId, number])
  @@index([companyId, invoiceId])
}

model RefundAttempt {
  id String @id
  companyId String
  creditNoteId String
  settlementId String
  actorId String
  reason String
  requestHash String
  providerRequestId String @default(uuid())
  provider String
  merchantId String
  captureId String
  currency String
  amountCents Int
  status String @default("PENDING")
  externalId String?
  confirmedAt DateTime?
  verifiedAt DateTime?
  lastProof Json?
  reservationReleasedAt DateTime?
  createdAt DateTime @default(now())
  creditNote CreditNote @relation(fields: [companyId, creditNoteId], references: [companyId, id], onDelete: Restrict)
  settlement PaymentSettlement @relation(fields: [companyId, settlementId], references: [companyId, id], onDelete: Restrict)
  allocations RefundAllocation[]
  reviewEvents RefundReviewEvent[]
  payoutLines PayoutLine[]
  @@unique([companyId, id])
  @@unique([provider, merchantId, externalId])
  @@index([companyId, creditNoteId])
  @@index([companyId, settlementId])
}

// Relevés fictifs déclarés : jamais une preuve de connexion bancaire.
model PayoutStatement {
  id String @id
  companyId String
  actorId String
  requestHash String
  contentHash String
  statementRef String
  provider String
  merchantId String
  currency String
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payouts BankPayout[]
  @@unique([companyId, id])
  @@unique([companyId, contentHash])
  @@unique([companyId, provider, merchantId, statementRef])
}

model BankPayout {
  id String @id @default(uuid())
  companyId String
  statementId String
  provider String
  merchantId String
  currency String
  externalRef String
  declaredNetCents Int
  receivedCents Int?
  bankReference String?
  receivedAt DateTime?
  validatedAt DateTime?
  validatedBy String?
  createdAt DateTime @default(now())
  statement PayoutStatement @relation(fields: [companyId, statementId], references: [companyId, id], onDelete: Cascade)
  lines PayoutLine[]
  decisions PayoutDecision[]
  @@unique([companyId, id])
  @@unique([companyId, provider, merchantId, externalRef])
  @@index([companyId, createdAt])
}

model PayoutLine {
  id String @id @default(uuid())
  companyId String
  payoutId String
  provider String
  merchantId String
  kind String
  externalRef String
  amountCents Int
  settlementId String?
  refundId String?
  payout BankPayout @relation(fields: [companyId, payoutId], references: [companyId, id], onDelete: Cascade)
  settlement PaymentSettlement? @relation(fields: [companyId, settlementId], references: [companyId, id], onDelete: Restrict)
  refund RefundAttempt? @relation(fields: [companyId, refundId], references: [companyId, id], onDelete: Restrict)
  @@unique([companyId, provider, merchantId, kind, externalRef])
  @@unique([companyId, settlementId])
  @@unique([companyId, refundId])
  @@index([companyId, payoutId])
}

model PayoutDecision {
  id String @id
  companyId String
  payoutId String
  actorId String
  requestHash String
  snapshot Json
  createdAt DateTime @default(now())
  payout BankPayout @relation(fields: [companyId, payoutId], references: [companyId, id], onDelete: Cascade)
  @@index([companyId, payoutId])
}

model RefundReviewEvent {
  id String @id @default(uuid())
  companyId String
  refundId String
  actorId String
  action String
  requestHash String?
  snapshot Json
  createdAt DateTime @default(now())
  refund RefundAttempt @relation(fields: [companyId, refundId], references: [companyId, id], onDelete: Cascade)
  @@index([companyId, refundId, createdAt])
}

// Réservation du remboursement sur la part réellement réglée de chaque vente.
model RefundAllocation {
  id String @id @default(uuid())
  companyId String
  refundId String
  orderId String
  amountCents Int
  refund RefundAttempt @relation(fields: [companyId, refundId], references: [companyId, id], onDelete: Cascade)
  order Order @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Restrict)
  @@unique([companyId, refundId, orderId])
  @@index([companyId, orderId])
}

// Sortie déclarée et justifiée, sans prétendre à une confirmation bancaire.
model ManualRefund {
  id String @id
  companyId String
  creditNoteId String
  tenderId String
  actorId String
  method String
  amountCents Int
  currency String
  reason String
  reference String
  requestHash String
  snapshot Json
  cashMovementId String? @unique
  createdAt DateTime @default(now())
  creditNote CreditNote @relation(fields: [companyId, creditNoteId], references: [companyId, id], onDelete: Restrict)
  tender OrderTender @relation(fields: [companyId, tenderId], references: [companyId, id], onDelete: Restrict)
  cashMovement CashMovement? @relation(fields: [cashMovementId], references: [id], onDelete: Restrict)
  @@unique([companyId, id])
  @@index([companyId, creditNoteId])
  @@index([companyId, tenderId])
}

model InvoiceDelivery {
  id            String @id
  companyId     String
  invoiceId     String
  userId        String
  recipient     String
  requestHash   String
  documentHash  String
  status        String @default("QUEUED")
  attempts      Int @default(0)
  providerId    String?
  lastErrorCode String?
  createdAt     DateTime @default(now())
  claimedAt     DateTime?
  acceptedAt    DateTime?
  invoice       Invoice @relation(fields: [companyId, invoiceId], references: [companyId, id])
  @@index([companyId, status])
}

// Capacité au porteur : aucun jeton clair conservé, aucun document réécrit.
model InvoiceDocumentLink {
  id String @id
  companyId String
  invoiceId String
  actorId String
  requestHash String
  documentHash String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  revokedBy String?
  revocationReason String?
  invoice Invoice @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: Restrict)
  events InvoiceDocumentLinkEvent[]
  @@unique([companyId, id])
  @@index([companyId, invoiceId, createdAt])
}

// Append-only dans l'API. Ne contient ni capacité, ni destinataire, ni URL.
model InvoiceDocumentLinkEvent {
  id String @id @default(uuid())
  companyId String
  linkId String
  action String
  actorId String?
  createdAt DateTime @default(now())
  link InvoiceDocumentLink @relation(fields: [companyId, linkId], references: [companyId, id], onDelete: Restrict)
  @@index([companyId, linkId, createdAt])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float   @default(17)
  taxReason   String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Quote {
  id         String    @id @default(cuid())
  companyId  String
  customerId String?
  number     String
  status     String    @default("DRAFT") // DRAFT|SENT|ACCEPTED|REJECTED|EXPIRED
  validUntil DateTime?
  convertedInvoiceId String?
  convertedAt DateTime?
  total      Float     @default(0)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId], references: [id])
  items    QuoteItem[]
  convertedInvoice Invoice? @relation(fields: [companyId, convertedInvoiceId], references: [companyId, id], onDelete: Restrict, map: "Quote_convertedInvoice_fkey")

  @@unique([companyId, number])
  @@unique([companyId, convertedInvoiceId])
  @@index([companyId, status])
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float  @default(17)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

// ─── RESERVATIONS ──────────────────────────────────────

model Reservation {
  id         String    @id @default(cuid())
  companyId  String
  tableId    String?
  customerId String?
  guestName  String
  guestPhone String?
  guestEmail String?
  date       DateTime
  partySize  Int       @default(2)
  status     String    @default("PENDING") // PENDING|CONFIRMED|CANCELLED|SEATED|NO_SHOW
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  table   Table?  @relation(fields: [tableId], references: [id])

  @@index([companyId, date, status])
}

// ─── INVENTAIRE ────────────────────────────────────────

model Ingredient {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  unit          String   @default("kg")
  costPerUnit   Float    @default(0)
  currentStock  Float    @default(0)
  minStockLevel Float    @default(0)
  supplierId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier      Supplier?          @relation(fields: [supplierId], references: [id])
  recipes       Recipe[]
  purchaseItems PurchaseOrderItem[]

  @@index([companyId])
}

model Recipe {
  id           String @id @default(cuid())
  productId    String
  ingredientId String
  quantity     Float

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
}

model Supplier {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  contactName String?
  email       String?
  phone       String?
  notes       String?
  createdAt   DateTime @default(now())

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ingredients    Ingredient[]
  purchaseOrders PurchaseOrder[]

  @@index([companyId])
}

model PurchaseOrder {
  id         String   @id @default(cuid())
  companyId  String
  supplierId String
  status     String   @default("DRAFT") // DRAFT|SENT|RECEIVED
  total      Float    @default(0)
  notes      String?
  createdAt  DateTime @default(now())

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@index([companyId])
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  ingredientId    String
  quantity        Float
  unitCost        Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])
}

// ─── RH ────────────────────────────────────────────────

model Shift {
  id           String   @id @default(cuid())
  companyId    String
  userId       String
  role         String
  startTime    DateTime
  endTime      DateTime
  breakMinutes Int      @default(0)
  notes        String?
  status       String   @default("SCHEDULED") // SCHEDULED|CONFIRMED|COMPLETED
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId, startTime])
}

model TimePunch {
  id         String    @id @default(cuid())
  companyId  String
  userId     String
  clockIn    DateTime
  clockOut   DateTime?
  note       String?
  verifiedBy String?
  createdAt  DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId, userId, clockIn])
