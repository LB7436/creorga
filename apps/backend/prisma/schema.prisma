// ─── HACCP ─────────────────────────────────────────────

model HaccpLog {
  id          String   @id @default(cuid())
  companyId   String
  type        String   // FRIDGE_TEMP|CLEANING|RECEIVING|PEST_CONTROL
  value       Float?
  source      String?
  notes       String?
  loggedAt    DateTime @default(now())
  loggedBy    String
