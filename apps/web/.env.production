# Variables injectées par Vite au build de production (npm run build).
#
# Elles pointaient jusqu'ici vers un tunnel Cloudflare éphémère
# (museum-bigger-feature-transmission.trycloudflare.com) créé pour une démo en
# mai et mort depuis : en production, RobiOperator, l'assistant, le pointage
# géolocalisé et les écrans mobiles appelaient une adresse injoignable, en
# boucle. VITE_REMOTE_BACKEND est prioritaire sur VITE_BACKEND_URL dans les
# getBackend() : le corriger ici est le seul endroit qui règle tout.

VITE_BACKEND_URL=https://creorga.n8nautomatisations.org
VITE_REMOTE_BACKEND=https://creorga.n8nautomatisations.org

# Adresse de la caisse (apps/pos), qui héberge l'éditeur de plan de salle.
VITE_POS_URL=https://caisse.n8nautomatisations.org

# Ollama (assistant IA « Robi ») tourne en LOCAL sur le poste qui consulte,
# port 11434 — il n'y a pas d'instance sur le VPS et il n'y en aura pas :
# 100 % local est le parti pris du produit. Laissé vide, le code retombe sur
# http://localhost:11434, ce qui est le comportement voulu.
VITE_OLLAMA_URL=
