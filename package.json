{
  "name": "creorga",
  "version": "4.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/backend",
    "apps/pos",
    "apps/guest",
    "apps/superadmin"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/backend & npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "build": "npm run build --workspace=apps/web && npm run build --workspace=apps/backend",
    "build:business": "node scripts/build-local-profile.mjs business",
    "build:full": "node scripts/build-local-profile.mjs full",
    "start:business": "node scripts/local/runtime.mjs",
    "start:full": "node scripts/local/runtime.mjs --full",
    "test:local-profile": "node --test tests/local/*.test.mjs",
    "db:migrate": "npm run db:migrate --workspace=apps/backend",
    "db:seed": "npm run db:seed --workspace=apps/backend",
    "db:studio": "npm run db:studio --workspace=apps/backend",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
